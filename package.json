{
  "name": "pi-everywhere-local",
  "version": "0.1.0",
  "private": true,
  "description": "Use the same live Pi process from its TUI and a mobile-friendly web interface.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "remote-ui"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "bin": {
    "pi-everywhere": "./dist/src/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "setup": "npm run build && node dist/src/cli/index.js setup",
    "status": "node dist/src/cli/index.js status",
    "doctor": "node dist/src/cli/index.js doctor",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/src/cli/index.js', 0o755)\"",
    "start": "node dist/src/server/index.js",
    "typecheck": "tsc --noEmit",
    "check:web": "node --check web/app.js && node --check web/markdown.js && node --check web/session-list.js && node --check web/sw.js",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run check:web && npm test && npm run build"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@types/node": "^24.10.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
