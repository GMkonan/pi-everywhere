{
  "name": "pi-everywhere-local",
  "version": "0.1.0",
  "private": true,
  "description": "Use the same live Pi process from its TUI and a mobile-friendly web interface.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "remote-ui"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "bin": {
    "pi-everywhere": "./dist/src/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "cli": "tsx src/cli/index.ts",
    "setup": "npm run build && node dist/src/cli/index.js setup",
    "status": "node dist/src/cli/index.js status",
    "doctor": "node dist/src/cli/index.js doctor",
    "pair": "node dist/src/cli/index.js pair",
    "devices": "node dist/src/cli/index.js devices",
    "revoke": "node dist/src/cli/index.js revoke",
    "build": "tsc -p tsconfig.build.json && npm run build:web && node -e \"require('node:fs').chmodSync('dist/src/cli/index.js', 0o755)\"",
    "build:web": "vite build --config frontend/vite.config.ts",
    "start": "node dist/src/server/index.js",
    "typecheck": "tsc --noEmit",
    "check:web": "svelte-check --tsconfig ./frontend/tsconfig.json && node --check web/app.js && node --check web/markdown.js && node --check web/session-list.js && node --check web/sw.js && node --check frontend/public/sw.js",
    "test": "tsx --test test/*.test.ts",
    "test:web": "vitest run --config frontend/vitest.config.ts",
    "check": "npm run typecheck && npm run check:web && npm test && npm run test:web && npm run build"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "jsdom": "^26.1.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
